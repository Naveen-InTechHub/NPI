@page "/quote-request"
@using Syncfusion.Blazor.Inputs
<Header/>
<div class="ans-page">
    <div class="d-flex justify-content-between align-items-center">
        <div class="ans-page-title">New Product Initiation : <span>FGTEST - Daily EU 439EURL tablet</span> </div>
        <button class="ans-filter-btn">
            Cancel
        </button>
    </div>
    <div class="ans-card-container mt-3">
        <div class="row gy-3 gy-lg-0 gx-0 gx-lg-2">
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 ans-col-lg-5">
                <div class="ans-card-title">Review Information</div>
                <div class="ans-border"></div>
                <div class="ans-card-body">
                    <div class="ans-panel-left">
                        <div class="ans-field-row">
                            <div class="ans-field-label">Packout</div>
                            <div class="ans-field-value link">PS.2 Daily EU 439EURL - 60 CT</div>
                        </div>
                        <div class="ans-field-row">
                            <div class="ans-field-label">Quote Number</div>
                            <div class="ans-field-value">6514.0</div>
                        </div>
                        <div class="ans-field-row">
                            <div class="ans-field-label">Quote Desc</div>
                            <div class="ans-field-value">Daily EU 439EURL tablet</div>
                        </div>
                        <div class="ans-field-row">
                            <div class="ans-field-label">Prod Type</div>
                            <div class="ans-field-value">Tablet</div>
                        </div>
                    </div>

                    <div class="ans-panel-right">
                        <div class="ans-field-row">
                            <div class="ans-field-label">Customer</div>
                            <div class="ans-field-value">Aloe Vera of America 50415</div>
                        </div>
                        <div class="ans-field-row">
                            <div class="ans-field-label">Sales Person</div>
                            <div class="ans-field-value">Antonia Matthaeus, Candice Axtell</div>
                        </div>
                        <div class="ans-field-row">
                            <div class="ans-field-label">Created By</div>
                            <div class="ans-field-value">Candice A</div>
                        </div>
                        <div class="ans-field-row">
                            <div class="ans-field-label">Created On</div>
                            <div class="ans-field-value">02-02-2025 11:20pm</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 ans-col-lg-7">
                <div class="ans-sub-card-container">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div class="ans-card-title">Formula : FS.2 Daily EU 439EURL 200k</div>
                        <button class="ans-edit-btn" data-bs-toggle="modal" data-bs-target="#editFormulaModal">
                            <img src="assets/img/icon/edit.svg" />Edit
                        </button>
                    </div>
                    <div class="ans-border"></div>
                    <div class="ans-card-body1">
                        <div class="ans-panel-left">
                            <div class="ans-field-row">
                                <div class="ans-field-label">Prod Type</div>
                                <div class="ans-field-value">Tablet</div>
                            </div>
                            <div class="ans-field-row">
                                <div class="ans-field-label">Pkg Type</div>
                                <div class="ans-field-value">Bottles</div>
                            </div>
                            <div class="ans-field-row">
                                <div class="ans-field-label">Order Quantity</div>
                                <div class="ans-field-value">2000000</div>
                            </div>
                            <div class="ans-field-row">
                                <div class="ans-field-label">No of Batches</div>
                                <div class="ans-field-value">2</div>
                            </div>
                        </div>

                        <div class="ans-panel-right">
                            <div class="ans-field-row">
                                <div class="ans-field-label">Total Units</div>
                                <div class="ans-field-value">2000000</div>
                            </div>
                            <div class="ans-field-row">
                                <div class="ans-field-label">Savings Per unit</div>
                                <div class="ans-field-value">30.000</div>
                            </div>
                            <div class="ans-field-row">
                                <div class="ans-field-label">Formula Size</div>
                                <div class="ans-field-value">12000.000</div>
                            </div>
                            <div class="ans-field-row">
                                <div class="ans-field-label">Blunder</div>
                                <div class="ans-field-value">023000 Cuft Rotary</div>
                            </div>
                        </div>
                        <div class="ans-panel-right">
                            <div class="ans-field-row">
                                <div class="ans-field-label">Total Savings</div>
                                <div class="ans-field-value">600000</div>
                            </div>
                            <div class="ans-field-row">
                                <div class="ans-field-label">Formula Kg</div>
                                <div class="ans-field-value">8892.20</div>
                            </div>
                            <div class="ans-field-row">
                                <div class="ans-field-label">Bulk Density</div>
                                <div class="ans-field-value">0.8</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Stepper Bar ── -->

    <div class="stepper mt-3 mb-3">
        <div class="step active" onclick="goTo(0)">
            <div class="step-body"></div>
            <div class="step-inner">
                <div class="step-num">1</div>
                <span class="step-label">NPI Setup</span>
            </div>
        </div>

        <div class="step" onclick="goTo(1)">
            <div class="step-body"></div>
            <div class="step-inner">
                <div class="step-num">2</div>
                <span class="step-label">FGSS Setup</span>
            </div>
        </div>

        <div class="step" onclick="goTo(2)">
            <div class="step-body"></div>
            <div class="step-inner">
                <div class="step-num">3</div>
                <span class="step-label">Testing Setup</span>
            </div>
        </div>

        <div class="step" onclick="goTo(3)">
            <div class="step-body"></div>
            <div class="step-inner">
                <div class="step-num">4</div>
                <span class="step-label">Packaging Setup</span>
            </div>
        </div>

        <div class="step" onclick="goTo(4)">
            <div class="step-body"></div>
            <div class="step-inner">
                <div class="step-num">5</div>
                <span class="step-label">Sampling Plan</span>
            </div>
        </div>

    </div>
    <!-- /stepper -->
    <!-- ── Content Panels ── -->
    <div class="panels">
        <!-- Step 1: NPI Setup -->
        <div class="panel active" id="panel-0">
            <NPISetup/>
        </div>

        <!-- Step 2: Formulation -->
        <div class="panel" id="panel-1">
        </div>

        <!-- Step 3: Testing Setup -->
        <div class="panel" id="panel-2">
        </div>

        <!-- Step 4: Packaging Setup -->
        <div class="panel" id="panel-3">
        </div>

        <!-- Step 5: Sampling Plan -->
        <div class="panel" id="panel-4">
            <SamplingPlan/>
        </div>

    </div>
    <!-- /panels -->
    <!-- ── Navigation ── -->
    @* <div class="stepper-nav">
        <span class="step-indicator" id="stepIndicator">Step 1 of 5</span>
        <div class="nav-btns">
            <button class="btn btn-prev" id="btnPrev" onclick="changeStep(-1)" disabled>&#8592; Previous</button>
            <button class="btn btn-next" id="btnNext" onclick="changeStep(1)">Next &#8594;</button>
        </div>
    </div> *@
</div>
<!-- Modal -->
<div class="modal fade" id="editFormulaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">

        <div class="modal-content ans-modal">

            <!-- Header -->
            <div class="modal-header d-flex gap-3 align-items-center" style="background-color: rgba(37, 99, 235, 0.05); padding: 15px;">
                <div>
                    <div class="ans-card-title" style="color: var(--primary-color); font-size: 16px;">Edit Formula</div>
                    <div class="ans-para mb-0 mt-1">Product and internal item codes used for tracking and production.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body pt-2">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Production Type</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Package Type</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Order Quantity</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">No of Batches</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Formula Size</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Total Units</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Savings Per Unit</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Blunder</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Total Savings</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Formula Kg</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Bulk Density</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex-end gap-2 justify-content-end px-2 mb-3">
                <button class="ans-secondary-button smal-size px-4" style="font-size: 14px" data-bs-dismiss="modal">Cancel</button>
                <button class="ans-primary-button smal-size px-4" style="font-size: 14px">Update</button>
            </div>

        </div>
    </div>
</div>

<Footer/>

@code {
    private bool isChecked = true;

}
