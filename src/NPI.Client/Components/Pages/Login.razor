@page "/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using NPI.Client.ViewModels.Auth
@using Syncfusion.Blazor.Inputs
@inject LoginViewModel LoginViewModel
<style>
    

    /* LEFT IMAGE SECTION */
    .login-left {
        flex: 1;
        background-image: url('assets/login bg.png');
        background-size: cover; /* makes image cover full area */
        background-position: center; /* keeps it centered */
        background-repeat: no-repeat; /* prevents multiplying */
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px;
        color: white;
    }

    .brand-logo {
        font-size: 22px;
        font-weight: 600;
    }

    .left-bottom-text {
        font-size: 28px;
        font-style: normal;
        font-weight: 700;
        line-height: normal;
        max-width: 440px;
    }


    /* RIGHT FORM SECTION */
    .login-right {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        background-image: url('assets/img/login-bg.png');
        background-repeat: no-repeat;
        background-position: bottom;
        mix-blend-mode: multiply;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
    }


    /* RESPONSIVE */
    @@media (max-width: 900px) {
        .login-left

    {
        display: none;
    }

    .login-right {
        flex: 1;
    }

    }
</style>
<div class="ans-login-container">
    <!-- LEFT SIDE -->
    <div class="login-left">
        <div class="brand-logo">
            <img src="/logo.webp" height="40" />
        </div>

        <div class="left-bottom-text">
            Powering Performance. Precision in Nutrition.
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="login-right">
        <div class="login-card">

            <h3 class="ans-big-title">Welcome Back 👋🏻</h3>
            <p class="ans-para ans-mb-30">
                Access your manufacturing dashboard to manage formulations,
                production, quality, and compliance—securely and efficiently.
            </p>

            <EditForm Model="LoginViewModel.LoginModel" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group mb-4">
                    <label class="ans-label ans-mb-12">Email</label>
                    <div class="ans-text-box">
                       <SfTextBox @bind-Value="LoginViewModel.LoginModel.Username" Placeholder="Enter the email"></SfTextBox>
                    </div>
                </div>

                <div class="form-group mb-4">
                     <label class="ans-label ans-mb-12">Password</label>
                    <div class="ans-text-box">
                       <SfTextBox Type="InputType.Password" @bind-Value="LoginViewModel.LoginModel.Password" Placeholder="Enter the password"></SfTextBox>
                    </div>
                   
                </div>

                @if (!string.IsNullOrEmpty(LoginViewModel.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        @LoginViewModel.ErrorMessage
                    </div>
                }
                <div class="mt-4">
                    <SfProgressButton Content="Login" Type="Submit" CssClass="ans-lgon-btn"></SfProgressButton>
                </div>                
            </EditForm>

        </div>
        <div class="ans-login-footer">© 2026 Arizona Nutritional Supplements. All rights reserved.</div>
    </div>

</div>

@code {

    [Parameter]
    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    public async Task LoginAsync()
    {
        LoginViewModel.ErrorMessage = null;

        var response = await AuthService.LoginAsync(LoginViewModel.LoginModel);

        if (response.Success && response.Data != null)
        {
            await AuthProvider.MarkUserAsAuthenticated(response.Data);
            NavigationManager.NavigateTo(returnUrl ?? "/");
        }
        else
        {
            LoginViewModel.ErrorMessage = response.Message ?? "Login failed. Please try again.";
        }

    }
}
