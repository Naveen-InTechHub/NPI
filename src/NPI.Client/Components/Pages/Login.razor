@page "/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using NPI.Client.ViewModels.Auth
@inject LoginViewModel LoginViewModel

<style>
    /* Full screen background */
    .login-wrapper {
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #0f172a, #0f172a);
        padding: 15px;
    }

    /* Card container */
    .login-card {
        background: white;
        padding: 40px 30px;
        width: 380px;
        max-width: 100%;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        animation: fadeIn 0.4s ease-in-out;
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    /* Card title and subtitle */
    .login-title {
        text-align: center;
        font-weight: 600;
        font-size: 24px;
        margin-bottom: 5px;
    }

    .login-subtitle {
        text-align: center;
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 25px;
    }

    /* Form styling */
    .login-card form {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    /* Form groups */
    .form-group {
        margin-bottom: 18px;
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            margin-bottom: 6px;
            font-weight: 500;
            font-size: 14px;
        }

    /* Input styling */
    .custom-input {
        height: 45px;
        padding: 10px 14px;
        border-radius: 8px;
        border: 1px solid #ced4da;
        font-size: 14px;
        transition: 0.3s;
    }

        .custom-input:focus {
            outline: none;
            border-color: #4e73df;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
        }

    /* Button styling */
    .login-btn {
        margin-top: 10px;
        height: 45px;
        border-radius: 8px;
        background-color: #0284c7;
        color: white;
        font-weight: 500;
        font-size: 16px;
        text-align: center;
        transition: 0.3s;
        border: none;
    }

        .login-btn:hover {
            background-color: #0284c7;
            cursor: pointer;
        }

    /* Alert styling */
    .login-alert {
        border-radius: 8px;
        font-size: 14px;
        padding: 10px 15px;
        margin-bottom: 15px;
    }

    /* Fade-in animation */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive tweaks */
    @@media (max-width: 500px) {
        .login-card {
            padding: 30px 20px;
        }

        .login-title {
            font-size: 20px;
        }

        .login-subtitle {
            font-size: 12px;
            margin-bottom: 20px;
        }

        .login-btn {
            font-size: 15px;
            justify-content: center !important;
        }
    }
</style>


<div class="login-wrapper">
    <div class="login-card">

        <h3 class="login-title">Welcome Back</h3>
        <p class="login-subtitle">Please login to continue</p>

        <EditForm Model="LoginViewModel.LoginModel" OnValidSubmit="LoginAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Username</label>
                <InputText class="form-control custom-input"
                           @bind-Value="LoginViewModel.LoginModel.Username" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <InputText type="password"
                           class="form-control custom-input"
                           @bind-Value="LoginViewModel.LoginModel.Password" />
            </div>


            @if (!string.IsNullOrEmpty(LoginViewModel.ErrorMessage))
            {
                <div class="alert alert-danger login-alert">
                    <p style="color:red">
                        @LoginViewModel.ErrorMessage
                    </p>
                </div>
            }

            <button type="submit" class="login-btn">
                Login
            </button>
        </EditForm>

    </div>
</div>


@code {

    [Parameter]
    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    public async Task LoginAsync()
    {
        LoginViewModel.ErrorMessage = null;

        var response = await AuthService.LoginAsync(LoginViewModel.LoginModel);

        if (response.Success && response.Data != null)
        {
            await AuthProvider.MarkUserAsAuthenticated(response.Data);
            NavigationManager.NavigateTo(returnUrl ?? "/");
        }
        else
        {
            LoginViewModel.ErrorMessage = response.Message ?? "Login failed. Please try again.";
        }

    }
}
