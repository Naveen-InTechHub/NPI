@page "/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using NPI.Client.ViewModels.Auth
@inject LoginViewModel LoginViewModel
<style>
    .login-container {
        display: flex;
        height: 100vh;
        width: 100%;
        overflow: hidden;
    }

    /* LEFT IMAGE SECTION */
    .login-left {
        flex: 1;        
        background-image: url('assets/login bg.png');
        background-size: cover; /* makes image cover full area */
        background-position: center; /* keeps it centered */
        background-repeat: no-repeat; /* prevents multiplying */
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px;
        color: white;
    }

    .brand-logo {
        font-size: 22px;
        font-weight: 600;
    }

    .left-bottom-text {
        font-size: 28px;
        font-weight: 600;
        max-width: 400px;
        line-height: 1.4;
    }

        .left-bottom-text span {
            font-style: italic;
            font-weight: 500;
        }

    /* RIGHT FORM SECTION */
    .login-right {
        flex: 1;
        background: #f8fafc;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
    }

    .login-title {
        font-size: 28px;
        font-weight: 600;
        color: #2563eb;
        margin-bottom: 10px;
    }

    .login-subtitle {
        color: #6b7280;
        margin-bottom: 30px;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .custom-input {
        height: 48px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        padding: 10px 15px;
        font-size: 14px;
    }

        .custom-input:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

    .login-btn {
        height: 50px;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        font-size: 16px;
        font-weight: 500;
        border: none;
        width: 100%;
        margin-top: 10px;
        transition: 0.3s ease;
    }

        .login-btn:hover {
            background: #1d4ed8;
        }

    /* RESPONSIVE */
    @@media (max-width: 900px) {
        .login-left {
            display: none;
        }

        .login-right {
            flex: 1;
        }
    }
</style>

<div class="login-container">

    <!-- LEFT SIDE -->
    <div class="login-left">
        <div class="brand-logo">
            <img src="/logo.webp" height="40" />
        </div>

        <div class="left-bottom-text">
            Powering <span>Performance.</span> Precision in <span>Nutrition.</span>
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="login-right">
        <div class="login-card">

            <h3 class="login-title">Welcome Back 👋</h3>
            <p class="login-subtitle">
                Access your manufacturing dashboard to manage formulations,
                production, quality, and compliance—securely and efficiently.
            </p>

            <EditForm Model="LoginViewModel.LoginModel" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label>Email</label>
                    <InputText class="form-control custom-input"
                               @bind-Value="LoginViewModel.LoginModel.Username"
                               placeholder="Enter email" />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <InputText type="password"
                               class="form-control custom-input"
                               @bind-Value="LoginViewModel.LoginModel.Password"
                               placeholder="Enter password" />
                </div>

                @if (!string.IsNullOrEmpty(LoginViewModel.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        @LoginViewModel.ErrorMessage
                    </div>
                }

                <button type="submit" class="login-btn">
                    Login
                </button>
            </EditForm>

        </div>
    </div>

</div>

@code {

    [Parameter]
    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    public async Task LoginAsync()
    {
        LoginViewModel.ErrorMessage = null;

        var response = await AuthService.LoginAsync(LoginViewModel.LoginModel);

        if (response.Success && response.Data != null)
        {
            await AuthProvider.MarkUserAsAuthenticated(response.Data);
            NavigationManager.NavigateTo(returnUrl ?? "/");
        }
        else
        {
            LoginViewModel.ErrorMessage = response.Message ?? "Login failed. Please try again.";
        }

    }
}
