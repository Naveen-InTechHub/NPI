@page "/"
@page "/npi"
@using NPI.Client.DTOs.Auth
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Navigations
@inject NpiListViewModel VM
@inject NavigationManager Nav

<PageTitle>Bids Won Overview - ANS</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap');

    :root {
        --ans-primary:    #1e3a8a;
        --ans-accent:     #2563eb;
        --ans-accent-hov: #1d4ed8;
        --ans-surface:    #ffffff;
        --ans-bg:         #f0f2f7;
        --ans-border:     #e2e8f0;
        --ans-text:       #0f172a;
        --ans-muted:      #64748b;
        --ans-r:          10px;
        --ans-r-sm:       7px;
        --nav-h:          54px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body, .ans-root {
        font-family: 'DM Sans', -apple-system, sans-serif;
        background: var(--ans-bg);
        color: var(--ans-text);
        min-height: 100vh;
        font-size: 12px;
    }

    /* ════ NAV ════ */
    .ans-nav {
        position: sticky; top: 0; z-index: 200;
        height: var(--nav-h);
        background: var(--ans-primary);
        display: flex; align-items: center;
        padding: 0 20px; gap: 6px;
        box-shadow: 0 2px 12px rgba(0,0,0,.22);
    }
    .nav-logo {
        display: flex; align-items: center; gap: 10px;
        text-decoration: none; color: white;
        font-size: 18px; font-weight: 700; letter-spacing: -.4px;
        flex-shrink: 0;
    }
    .nav-logo-icon {
        width: 34px; height: 34px; border-radius: 8px;
        background: rgba(255,255,255,.15);
        display: flex; align-items: center; justify-content: center;
    }
    .nav-logo-tagline {
        font-size: 8.5px; font-weight: 400; opacity: .6;
        letter-spacing: .4px; text-transform: uppercase;
        line-height: 1.3; border-left: 1px solid rgba(255,255,255,.25);
        padding-left: 10px;
    }
    .nav-sep { width: 1px; height: 20px; background: rgba(255,255,255,.15); margin: 0 6px; flex-shrink: 0; }
    .nav-links {
        display: flex; align-items: center; gap: 2px; flex: 1;
        overflow-x: auto; scrollbar-width: none;
    }
    .nav-links::-webkit-scrollbar { display: none; }
    .nav-link {
        display: flex; align-items: center; gap: 6px;
        padding: 6px 12px; border-radius: 7px;
        color: rgba(255,255,255,.72); font-size: 13.5px; font-weight: 500;
        cursor: pointer; white-space: nowrap; text-decoration: none;
        border: none; background: transparent; font-family: inherit;
        transition: background .15s, color .15s;
    }
    .nav-link:hover { background: rgba(255,255,255,.1); color: white; }
    .nav-link.active { background: rgba(255,255,255,.18); color: white; }
    .nav-right { display: flex; align-items: center; gap: 8px; margin-left: auto; flex-shrink: 0; }
    .nav-search {
        display: flex; align-items: center; gap: 8px;
        background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18);
        border-radius: 8px; padding: 5px 12px;
        color: rgba(255,255,255,.6); font-size: 13px;
        cursor: text; min-width: 175px;
    }
    .nav-search kbd {
        margin-left: auto; background: rgba(255,255,255,.15);
        border-radius: 4px; padding: 1px 5px; font-size: 10.5px; font-family: inherit;
    }
    .nav-icon-btn {
        width: 34px; height: 34px; border-radius: 8px;
        background: rgba(255,255,255,.1); border: none;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; color: rgba(255,255,255,.75);
        transition: background .15s;
    }
    .nav-icon-btn:hover { background: rgba(255,255,255,.18); color: white; }
    .nav-avatar {
        width: 34px; height: 34px; border-radius: 50%;
        background: linear-gradient(135deg,#60a5fa,#3b82f6);
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 13px; font-weight: 700; cursor: pointer;
        border: 2px solid rgba(255,255,255,.25);
    }
    .nav-hamburger {
        display: none; width: 34px; height: 34px; border-radius: 7px;
        background: rgba(255,255,255,.1); border: none;
        color: white; align-items: center; justify-content: center; cursor: pointer;
    }

    /* Mobile drawer */
    .mobile-nav {
        display: none; position: fixed;
        top: var(--nav-h); left: 0; right: 0;
        background: var(--ans-primary);
        padding: 10px 16px 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,.3);
        z-index: 190; flex-direction: column; gap: 3px;
    }
    .mobile-nav.open { display: flex; }
    .mobile-nav .nav-link { justify-content: flex-start; width: 100%; }

    /* ════ PAGE ════ */
    .ans-page { max-width: 1800px; margin: 0 auto; padding: 28px 28px 48px; }

    /* ── Page Header ── */
    .page-header {
        display: flex; align-items: flex-start;
        justify-content: space-between; flex-wrap: wrap;
        gap: 14px; margin-bottom: 22px;
    }
    .page-title { font-size: 22px; font-weight: 700; color: var(--ans-text); line-height: 1.25; }
    .page-subtitle { font-size: 13px; color: var(--ans-muted); margin-top: 4px; }
    .header-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

    /* ── Buttons ── */
    .btn {
        display: inline-flex; align-items: center; gap: 7px;
        font-family: inherit; font-weight: 500; cursor: pointer;
        border-radius: var(--ans-r-sm); transition: all .15s;
        white-space: nowrap; padding: 8px 18px; font-size: 13.5px;
    }
    .btn-outline {
        background: white; border: 1.5px solid var(--ans-border); color: #374151;
    }
    .btn-outline:hover { border-color: #94a3b8; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .btn-filled {
        background: var(--ans-accent); color: white; border: none; font-weight: 600;
    }
    .btn-filled:hover { background: var(--ans-accent-hov); }

    /* ════ GRID CARD ════ */
    .grid-card {
        background: white;
        border: 1px solid var(--ans-border);
        border-radius: var(--ans-r);
        box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
        overflow: hidden;
    }

    /* ════ CUSTOM TABLE ════ */
    .ans-table-wrap { overflow-x: auto; }

    table.ans-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

    table.ans-table thead {
        background: #f8fafc;
        border-bottom: 1.5px solid var(--ans-border);
    }
    table.ans-table thead th {
        padding: 12px 14px;
        font-size: 12px;
        color: var(--ans-text);
        text-align: left;
        white-space: nowrap;
        user-select: none;
    }
    table.ans-table thead th.sortable { cursor: pointer; }
    table.ans-table thead th.sortable:hover { color: var(--ans-accent); }
    table.ans-table thead th.th-check { width: 44px; padding-left: 18px; }
    table.ans-table thead th.th-action { width: 64px; text-align: center; }

    /* Sort icons */
    .sort-icon { display: inline-flex; flex-direction: column; gap: 1px; margin-left: 4px; vertical-align: middle; opacity: .45; }
    .sort-icon svg { display: block; }
    th.sort-asc .sort-icon, th.sort-desc .sort-icon { opacity: 1; }

    /* Rows */
    table.ans-table tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: background .12s;
    }
    table.ans-table tbody tr:last-child { border-bottom: none; }
    table.ans-table tbody tr:hover { background: #f8fafc; }
    table.ans-table tbody tr.row-selected { background: #eff6ff; }

    table.ans-table tbody td {
        padding: 5px 5px;
        color: var(--ans-text);
        vertical-align: middle;
        white-space: nowrap;
    }
    table.ans-table tbody td.td-check { padding-left: 18px; width: 44px; }
    table.ans-table tbody td.td-action { text-align: center; width: 64px; }
    table.ans-table tbody td.td-muted { color: var(--ans-muted); }
    table.ans-table tbody td.td-wrap { white-space: normal; max-width: 200px; }

    /* Custom checkbox */
    .cb-wrap { display: flex; align-items: center; justify-content: center; }
    .cb-input {
        width: 16px; height: 16px; border: 1.5px solid #cbd5e1;
        border-radius: 4px; appearance: none; cursor: pointer;
        transition: background .15s, border-color .15s;
        position: relative; background: white;
    }
    .cb-input:checked {
        background: var(--ans-accent); border-color: var(--ans-accent);
    }
    .cb-input:checked::after {
        content: '';
        position: absolute; left: 4px; top: 1.5px;
        width: 5px; height: 9px;
        border: 2px solid white; border-top: none; border-left: none;
        transform: rotate(45deg);
    }
    .cb-input:hover:not(:checked) { border-color: var(--ans-accent); }

    /* ── Status Badges ── */
    .status-badge {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 4px 14px; border-radius: 99px;
        font-size: 11px; font-weight: 600; white-space: nowrap;
        min-width: 90px;
    }
    .badge-launched    { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .badge-inprogress  { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .badge-draft       { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }

    /* ── Action button ── */
    .action-btn {
        width: 32px; height: 32px; border-radius: 50%;
        background: transparent; border: 1.5px solid var(--ans-border);
        display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer; color: var(--ans-muted);
        transition: all .15s;
    }
    .action-btn:hover {
        border-color: var(--ans-accent); color: var(--ans-accent);
        background: #eff6ff;
    }

    /* ════ FOOTER / PAGINATION ════ */
    .table-footer {
        display: flex; align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-top: 1px solid var(--ans-border);
        background: #fafbfc;
        flex-wrap: wrap; gap: 10px;
    }
    .table-footer-info { font-size: 13px; color: var(--ans-muted); }
    .table-footer-info strong { color: var(--ans-text); font-weight: 600; }

    .pagination { display: flex; align-items: center; gap: 4px; }
    .pg-btn {
        min-width: 32px; height: 32px; padding: 0 8px;
        border-radius: 7px; border: 1.5px solid var(--ans-border);
        background: white; color: var(--ans-text);
        font-size: 13px; font-weight: 500; font-family: inherit;
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        transition: all .15s;
    }
    .pg-btn:hover:not(:disabled) { border-color: var(--ans-accent); color: var(--ans-accent); background: #eff6ff; }
    .pg-btn.active {
        background: var(--ans-accent); color: white;
        border-color: var(--ans-accent); font-weight: 700;
    }
    .pg-btn:disabled { opacity: .38; cursor: not-allowed; }
    .pg-arrow { width: 32px; }

    /* ════ RESPONSIVE ════ */
    @@media (max-width: 1024px) {
        .nav-search { display: none; }
    }
    @@media (max-width: 768px) {
        .ans-page { padding: 16px 14px 36px; }
        .nav-links, .nav-sep { display: none; }
        .nav-hamburger { display: flex; }
        .nav-search { display: none; }
        .page-title { font-size: 18px; }
        table.ans-table thead th,
        table.ans-table tbody td { padding: 10px 10px; font-size: 12.5px; }
    }
    @@media (max-width: 600px) {
        .table-footer { flex-direction: column; align-items: flex-start; gap: 12px; }
    }

    /* ── Syncfusion overrides (if using SfGrid) ── */
    .e-grid { font-family: 'DM Sans', sans-serif !important; border: none !important; }
</style>

<!-- Mobile nav -->
<div class="mobile-nav @(mobileOpen ? "open" : "")">
    <a class="nav-link" href="#">Home</a>
    <a class="nav-link" href="#">Project Tracker</a>
    <a class="nav-link" href="#">Quote Requests</a>
    <a class="nav-link active" href="#">Bids Won</a>
</div>

<div class="ans-root">

    <!-- ════ NAVIGATION ════ -->
    <nav class="ans-nav">
        <a class="nav-logo" href="#">
            <div class="nav-logo-icon">
                <svg width="18" height="18" viewBox="0 0 32 32" fill="white"><path d="M16 4L30 27H2L16 4Z"/></svg>
            </div>
            <span>ans</span>
            <span class="nav-logo-tagline">ARIZONA<br/>NUTRITIONAL<br/>SUPPLEMENTS</span>
        </a>
        <div class="nav-sep"></div>
        <div class="nav-links">
            <a class="nav-link" href="#">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>Home
            </a>
            <a class="nav-link" href="#">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>Project Tracker
            </a>
            <a class="nav-link" href="#">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Quote Requests
            </a>
            <a class="nav-link active" href="#">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>Bids Won
            </a>
        </div>
        <div class="nav-right">
            <div class="nav-search">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                Search <kbd>Ctrl K</kbd>
            </div>
            <button class="nav-icon-btn" title="Notifications">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
            </button>
            <div class="nav-avatar">CA</div>
            <button class="nav-hamburger" @onclick="() => mobileOpen = !mobileOpen">
                <svg width="18" height="18" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    @if (mobileOpen) { <path d="M18 6L6 18M6 6l12 12"/> }
                    else { <path d="M3 6h18M3 12h18M3 18h18"/> }
                </svg>
            </button>
        </div>
    </nav>

    <div class="ans-page">

        <!-- ════ PAGE HEADER ════ -->
        <div class="page-header">
            <div>
                <div class="page-title">Bids Won Overview</div>
                <div class="page-subtitle">Real-time insights into employee productivity, work patterns, and performance trends.</div>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline" @onclick="OpenFilters">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
                    Filters
                </button>
                <button class="btn btn-filled" @onclick="VM.ExportFile">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Export
                </button>
            </div>
        </div>

        <!-- ════ GRID CARD ════ -->
        <div class="grid-card">
            <div class="ans-table-wrap">
                <table class="ans-table">
                    <thead>
                        <tr>
                            <th class="th-check">
                                <div class="cb-wrap">
                                    <input type="checkbox" class="cb-input"
                                           checked="@AllSelected"
                                           />
                             @*        <input type="checkbox" class="cb-input"
                                           checked="@AllSelected"
                                           @onchange="ToggleSelectAll" /> *@
                                </div>
                            </th>
                            <th class="sortable @(SortCol=="CustomerName" ? (SortAsc?"sort-asc":"sort-desc") : "")"
                                @onclick='() => SortBy("CustomerName")'>
                                Customer Name
                                <span class="sort-icon">
                                    <svg width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M4 0L8 5H0L4 0Z" fill="@(SortCol=="CustomerName"&&SortAsc?"#2563eb":"#94a3b8")"/></svg>
                                    <svg width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M4 5L0 0H8L4 5Z" fill="@(SortCol=="CustomerName"&&!SortAsc?"#2563eb":"#94a3b8")"/></svg>
                                </span>
                            </th>
                            <th class="sortable @(SortCol=="ItemCode" ? (SortAsc?"sort-asc":"sort-desc") : "")"
                                @onclick='() => SortBy("ItemCode")'>
                                Item Code
                                <span class="sort-icon">
                                    <svg width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M4 0L8 5H0L4 0Z" fill="@(SortCol=="ItemCode"&&SortAsc?"#2563eb":"#94a3b8")"/></svg>
                                    <svg width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M4 5L0 0H8L4 5Z" fill="@(SortCol=="ItemCode"&&!SortAsc?"#2563eb":"#94a3b8")"/></svg>
                                </span>
                            </th>
                            <th>FG Item Code</th>
                            <th>Bulk Item Code</th>
                            <th class="sortable @(SortCol=="CreatedBy" ? (SortAsc?"sort-asc":"sort-desc") : "")"
                                @onclick='() => SortBy("CreatedBy")'>
                                Created By
                                <span class="sort-icon">
                                    <svg width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M4 0L8 5H0L4 0Z" fill="@(SortCol=="CreatedBy"&&SortAsc?"#2563eb":"#94a3b8")"/></svg>
                                    <svg width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M4 5L0 0H8L4 5Z" fill="@(SortCol=="CreatedBy"&&!SortAsc?"#2563eb":"#94a3b8")"/></svg>
                                </span>
                            </th>
                            <th>Created On</th>
                            <th>Status</th>
                            <th>Packout Description</th>
                            <th>Quote Description</th>
                            <th class="th-action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr style="border:none" class="@(row.Selected ?? false ? "row-selected" : "")">
                                <td class="td-check">
                                    <div class="cb-wrap">
                                        <input type="checkbox" class="cb-input"
                                               checked="@row.Selected"
                                               @onchange="() => ToggleRow(row)" />
                                    </div>
                                </td>
                                <td>@row.CustomerName</td>
                                <td class="td-muted">@row.ItemCode</td>
                                <td class="td-muted">@row.FGCode</td>
                                <td class="td-muted">@row.BulkCode</td>
                                <td> @(string.IsNullOrEmpty(row.CreatedBy) ? "Mike T." : row.CreatedBy) </td>
                                <td class="td-muted">@row.CreatedDate</td>
                                <td>
                                    <span class="status-badge @StatusClass(row.Status)">@GetStatusText(row.Status)</span>
                                </td>
                                <td class="td-muted td-wrap">@row.PackoutDescription</td>
                                <td class="td-muted td-wrap">@row.ProductDescription</td>
                                <td class="td-action">
                                    <button class="action-btn" title="Mark as done" @onclick="() => HandleAction(row)">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ── Pagination Footer ── -->
            <div class="table-footer">
                <div class="table-footer-info">
                    Showing <strong>@PageSize</strong> of <strong>@TotalRows</strong> results
                </div>
                <div class="pagination">
                    <button class="pg-btn pg-arrow" @onclick="PrevPage" disabled="@(CurrentPage == 1)">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
                    </button>
                    @for (int p = 1; p <= TotalPages; p++)
                    {
                        var pg = p;
                        <button class="pg-btn @(pg == CurrentPage ? "active" : "")" @onclick="() => GoToPage(pg)">@pg</button>
                    }
                    <button class="pg-btn pg-arrow" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div style="text-align:center;margin-top:32px;font-size:12px;color:#94a3b8;">
            © 2026 Arizona Nutritional Supplements. All rights reserved.
        </div>

    </div>
</div>

@code {

    // ── Nav ─────────────────────────────────────────────────
    private bool mobileOpen = false;

 
    // ── Sorting ─────────────────────────────────────────────
    private string SortCol  = "CustomerName";
    private bool   SortAsc  = true;

    private void SortBy(string col)
    {
        if (SortCol == col) SortAsc = !SortAsc;
        else { SortCol = col; SortAsc = true; }
        ApplySort();
        CurrentPage = 1;
    }

    private void ApplySort()
    {
        VM.Records = SortCol switch
        {
            "CustomerName" => SortAsc ? VM.Records.OrderBy(r => r.CustomerName).ToList() : VM.Records.OrderByDescending(r => r.CustomerName).ToList(),
            "ItemCode"     => SortAsc ? VM.Records.OrderBy(r => r.ItemCode).ToList()     : VM.Records.OrderByDescending(r => r.ItemCode).ToList(),
            "CreatedBy"    => SortAsc ? VM.Records.OrderBy(r => r.CreatedBy).ToList()    : VM.Records.OrderByDescending(r => r.CreatedBy).ToList(),
            _              => VM.Records
        };
    }

    // ── Selection ───────────────────────────────────────────
    private bool AllSelected => PagedRows.Any() && PagedRows.All(r => r.Selected ?? false);

    // private void ToggleSelectAll(ChangeEventArgs e)
    // {
    //     bool v = (bool)(e.Value ?? false);
    //     foreach (var r in PagedRows) r.Selected = v;
    // }
    private void ToggleRow(NpiRecordDto row) => row.Selected = !row.Selected;

    // ── Pagination ──────────────────────────────────────────
    private int CurrentPage = 1;
    private int PageSize    = 11;
    private int TotalRows   => VM.Records.Count;
    private int TotalPages  => (int)Math.Ceiling((double)TotalRows / PageSize);

    private IEnumerable<NpiRecordDto> PagedRows =>
        VM.Records.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void PrevPage() { if (CurrentPage > 1) CurrentPage--; }
    private void NextPage() { if (CurrentPage < TotalPages) CurrentPage++; }
    private void GoToPage(int p) => CurrentPage = p;

    // ── Status CSS ──────────────────────────────────────────
    private string StatusClass(NpiStatus status) => status switch
    {
        NpiStatus.Launched => "badge-launched",
        NpiStatus.InProgress => "badge-inprogress",
        NpiStatus.Draft => "badge-draft",
        _             => "badge-draft"
    };
    private string GetStatusText(NpiStatus status) => status switch
    {
        NpiStatus.InProgress => "In Progress",
        NpiStatus.PlannerLaunched => "Planner Launched",
        _ => status.ToString()
    };

    // ── Actions ─────────────────────────────────────────────
    private void OpenFilters()   { /* Open filter panel / modal */ }
    private void HandleExport()  { /* Export to CSV/Excel */ }
    private void HandleAction(NpiRecordDto row) { /* Mark as done or open detail */ }


    // Implementations

    UserData UserData = new UserData();
    protected override async Task OnInitializedAsync()
    {
        VM.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
        await VM.LoadAsync();
        UserData = await AuthService.GetCurrentUserAsync() ?? new UserData();
        var currentAuthState = await AuthProvider.GetAuthenticationStateAsync();
        if (currentAuthState.User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
        }
        ;
        StateHasChanged();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await VM.SearchAsync();
    }


}
