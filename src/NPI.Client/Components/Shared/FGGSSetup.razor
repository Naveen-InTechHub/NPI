<div class="ans-card-title">FGSS Setup</div>
<div class="ans-border"></div>
<div class="row g-3">
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Finished Goods Specifications</div>
                <div class="ans-mini-card-header-para">Define the physical and functional attributes of the finished product.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Dosage Form</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox @bind-Value="VM.FggsSetup.DosageForm" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Tablet Shape & Color</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox @bind-Value="VM.FggsSetup.ShapeAndColor" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Tablet Weight (mg)</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfNumericTextBox @bind-Value="VM.FggsSetup.TabletWeight" TValue="int" Placeholder="Enter"></SfNumericTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Dimensions (L × W × T)</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox @bind-Value="VM.FggsSetup.Dimension" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Coating Type (if applicable)</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.CoatingType">
                                <option disabled selected hidden></option>
                                <option value="Film">Film</option>
                                <option value="Sugar">Sugar</option>
                                <option value="Enteric">Enteric</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Flavor / Odor Characteristics</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox @bind-Value="VM.FggsSetup.Flavor" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Packaging Configuration</div>
                <div class="ans-mini-card-header-para">Specify how finished goods are packed and labeled.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Primary Packaging Type</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.PackageType">
                                <option disabled selected hidden></option>
                                <option value="Bottle">Bottle</option>
                                <option value="Blister">Blister</option>
                                <option value="Sachet">Sachet</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Count Per Unit</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfNumericTextBox @bind-Value="VM.FggsSetup.CountPerUnit" TValue="int" Placeholder="Enter"></SfNumericTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Container Material</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.ContainerMaterial">
                                <option disabled selected hidden></option>
                                <option value="HDPE">HDPE</option>
                                <option value="PET">PET</option>
                                <option value="Glass">Glass</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Closure Type</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.ClouserType">
                                <option disabled selected hidden></option>
                                <option value="CRC">CRC</option>
                                <option value="Standard">Standard</option>
                                <option value="Induction Seal">Induction Seal</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Secondary Packaging</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.SecondaryPackaging">
                                <option disabled selected hidden></option>
                                <option value="Carton">Carton</option>
                                <option value="Shrink wrap">Shrink wrap</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Label Version / SKU</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfNumericTextBox TValue="int" Placeholder="Enter" @bind-Value="VM.FggsSetup.LabelVersion"></SfNumericTextBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Quality & Release Criteria</div>
                <div class="ans-mini-card-header-para">Define quality checks required before product release.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        @if (VM.QualityQuestions != null)
                        {
                            foreach (var question in VM.QualityQuestions)
                            {
                                <div class="d-flex justify-content-between gap-3 mb-2">
                                    <div class="ans-mini-card-list-label">@question.QuestionText</div>
                                    <SfSwitch TChecked="bool?"
                                              Checked="@question.Value"
                                              CheckedChanged="(v)=> VM.ToggleQualityPackageQuestionAsync(question, v)"
                                              OnLabel="Yes"
                                              OffLabel="No"
                                              CssClass="ans-switch-btn flex-shrink-0">
                                    </SfSwitch>

                                </div>
                            }
                        }
                      
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        <div class="ans-mini-card-list-label mb-2">Acceptance Criteria Notes</div>
                        <div class="ans-textarea-box w-100">
                            <SfTextArea @bind-Value="NpiRecord.AcceptanceNotes" Placeholder="Enter" Width="100%" style="height: 130px;"></SfTextArea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row g-3 mt-0">
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Shelf Life & Storage Conditions</div>
                <div class="ans-mini-card-header-para">Establish stability and storage requirements.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Target Shelf Life</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.TargetShelfLife">
                                <option disabled selected hidden></option>
                                <option value="24 months">24 months</option>
                                <option value="36 months">36 months</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Storage Conditions</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.StorageConditions">
                                <option disabled selected hidden></option>
                                <option value="Ambient">Ambient</option>
                                <option value="Cool & Dry">Cool & Dry</option>
                                <option value="Controlled">Controlled</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Special Handling Instructions</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.SpecialHandling">
                                <option disabled selected hidden></option>
                                <option value="Light">Light</option>
                                <option value="Moisture">Moisture</option>
                                <option value="Temperature sensitivity">Temperature sensitivity</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Packaging & Component Assessment</div>
                <div class="ans-mini-card-header-para">Review packaging components and sourcing details.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        @if (VM.PackageQuestions != null)
                        {
                            foreach (var question in VM.PackageQuestions)
                            {
                                <div class="d-flex justify-content-between gap-3 mb-2">
                                    <div class="ans-mini-card-list-label">@question.QuestionText</div>
                                    <SfSwitch TChecked="bool?"
                                              Checked="@question.Value"
                                              CheckedChanged="(v)=> VM.ToggleQualityPackageQuestionAsync(question, v)"
                                              OnLabel="Yes"
                                              OffLabel="No"
                                              CssClass="ans-switch-btn flex-shrink-0">
                                    </SfSwitch>
                                </div>
                            }
                        }
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        <div class="ans-mini-card-list-label mb-2">Regulatory Market</div>
                        <div class="ans-select">
                            <select class="form-select" @bind="@VM.FggsSetup.RegulatoryMarket">
                                <option disabled selected hidden></option>
                                <option value="EU">EU</option>
                                <option value="US">US</option>
                                <option value="Other">Other</option>

                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">FGSS Notes & Exceptions</div>
                <div class="ans-mini-card-header-para">Capture any special instructions or deviations.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        <div class="ans-mini-card-list-label mb-2">Special FG Handling Notes</div>
                        <div class="ans-text-box ans-reduce-radius w-100">
                            <SfTextBox @bind-Value="NpiRecord.FGHandlingNotes" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        <div class="ans-mini-card-list-label mb-2">Known Risks or Constraints</div>
                        <div class="ans-text-box ans-reduce-radius w-100">
                            <SfTextBox @bind-Value="NpiRecord.KnownRisksNotes" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ── Navigation ── -->
<div class="stepper-nav mb-3">
    @* <span class="step-indicator" id="stepIndicator">Step 1 of 5</span> *@
    <div class="nav-btns">
        <button class="ans-secondary-button" id="btnPrev" @onclick="PreviousTab">Previous</button>
        <button class="ans-primary-button" id="btnNext" @onclick="SaveAndContinueAsync">Save & Continue</button>
    </div>
</div>
@code {
    [Parameter]
    public NpiRecordDto NpiRecord { get; set; } = new NpiRecordDto();
    [Parameter]
    public NpiDetailViewModel VM { get; set; }
    [Parameter]
    public EventCallback<int> TabNavigation { get; set; }

    public async Task SaveAndContinueAsync()
    {
        await VM.SaveFGGSSetup();
        await VM.SaveRecordAsync(false);
        await VM.LoadAsync(NpiRecord.Id);
        await TabNavigation.InvokeAsync(4); // Navigate to next tab (e.g., Tab 3)
    }

    public async Task PreviousTab()
    {
        await TabNavigation.InvokeAsync(0); // Navigate to previous tab (e.g., Tab 1)
    }

}
