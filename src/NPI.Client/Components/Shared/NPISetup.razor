<div class="ans-card-title">NPI Setup</div>
<div class="ans-border"></div>
<div class="row g-3">
    <div class="col-12 col-sm-12 col-md-12 col-lg-6">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Bulk & Packout Configuration</div>
                <div class="ans-mini-card-header-para">Define how the product bulk and packout will be handled during production.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row mt-2 mb-2">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        @if (NpiRecord.SetupQuestions != null)
                        {
                            foreach (var question in NpiRecord.SetupQuestions)
                            {
                                <div class="d-flex justify-content-between gap-3 mb-2">
                                    <div class="ans-mini-card-list-label">@question.QuestionText</div>
                                    <SfSwitch TChecked="bool?"
                                    Checked="@question.Value"
                                    CheckedChanged="(v)=> VM.ToggleSetupQuestionAsync(question, v)"
                                    OnLabel="Yes"
                                    OffLabel="No"
                                    CssClass="ans-switch-btn flex-shrink-0">
                                    </SfSwitch>

                                </div>
                            }
                        }

                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        <div class="ans-mini-card-list-label mb-2">Multiple Packout Notes</div>
                        <div class="ans-textarea-box w-100">
                            <SfTextArea @bind-Value="NpiRecord.SetupNotes" Placeholder="Enter" Width="100%" style="height: 80px;"></SfTextArea>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-6">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Item Identification</div>
                <div class="ans-mini-card-header-para">Product and internal item codes used for tracking and production.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row mt-2 mb-2">
                    <div class="col-12 col-sm-12 col-md-4 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Item Description</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox @bind-Value="NpiRecord.ItemDescription" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-4 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Bulk Item Code</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox @bind-Value="NpiRecord.BulkCode" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-4 col-lg-4 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Finished Goods (FG) Item Code</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfTextBox @bind-Value="NpiRecord.FGCode" Placeholder="Enter"></SfTextBox>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<div class="row g-3 mt-0">
    <div class="col-12 col-sm-12 col-md-12 col-lg-6">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Commercial & Pricing Details</div>
                <div class="ans-mini-card-header-para">Commercial assumptions used for planning and forecasting.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row mt-2 mb-2">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Theoretical Unit Sales Price</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfNumericTextBox TValue="decimal" @bind-Value="@NpiRecord.UnitPrice" Placeholder="Enter"></SfNumericTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Theoretical Standard Order Quantity</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfNumericTextBox TValue="decimal" @bind-Value="@NpiRecord.OrderQty" Placeholder="Enter"></SfNumericTextBox>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Quoted Lead Time (Business Days)</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfNumericTextBox TValue="int" @bind-Value="@NpiRecord.LeadTimeDays" Placeholder="Enter"></SfNumericTextBox>

                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6 mb-2">
                        <div class="ans-mini-card-list-label mb-2">Estimated Purchase Order Value</div>
                        <div class="ans-text-box ans-reduce-radius">
                            <SfNumericTextBox TValue="decimal" @bind-Value="@NpiRecord.POValue" Placeholder="Enter"></SfNumericTextBox>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-6">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Bulk & Packout Configuration</div>
                <div class="ans-mini-card-header-para">Define how the product bulk and packout will be handled during production.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row mt-2 mb-2">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        @if (NpiRecord.PilotRequirements != null)
                        {
                            foreach (var question in NpiRecord.PilotRequirements)
                            {
                                <div class="d-flex justify-content-between gap-3 mb-2">
                                    <div class="ans-mini-card-list-label">@question.QuestionText</div>
                                    <SfSwitch TChecked="bool?"
                                    Checked="@question.Value"
                                    CheckedChanged="(v)=> VM.TogglePilotAsync(question, v)"
                                    OnLabel="Yes"
                                    OffLabel="No"
                                    CssClass="ans-switch-btn flex-shrink-0">
                                    </SfSwitch>

                                </div>
                            }
                        }

                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                        <div class="ans-mini-card-list-label mb-2">Multiple Packout Notes</div>
                        <div class="ans-textarea-box w-100">
                            <SfTextArea @bind-Value="NpiRecord.PilotNotes" Placeholder="Enter" Width="100%" style="height: 100px;"></SfTextArea>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<div class="row g-3 mt-0">
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Formula & Raw Material Assessment</div>
                <div class="ans-mini-card-header-para">Identify changes or risks related to formula and raw materials.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row mt-2 mb-2">
                    <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                        @if (VM.RawMaterialQuestions != null)
                        {
                            @foreach (var q in VM.RawMaterialQuestions)
                            {
                                <div class="d-flex justify-content-between gap-3 mb-2">
                                    <div class="ans-mini-card-list-label">@q.QuestionText</div>
                                    <SfSwitch TChecked="bool?"
                                              Checked="@q.Value"
                                              CheckedChanged="(v)=> VM.TogglePlannerAsync(q, v)"
                                              OnLabel="Yes"
                                              OffLabel="No"
                                              CssClass="ans-switch-btn flex-shrink-0">
                                    </SfSwitch>
                                </div>
                            }
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Packaging & Component Assessment</div>
                <div class="ans-mini-card-header-para">Review packaging components and sourcing details.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row mt-2 mb-2">
                    <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                        @if (VM.ComponentAssesmentsQuestion != null)
                        {
                            foreach (var question in VM.ComponentAssesmentsQuestion)
                            {
                                <div class="d-flex justify-content-between gap-3 mb-2">
                                    <div class="ans-mini-card-list-label">@question.QuestionText</div>
                                    <SfSwitch TChecked="bool?"
                                              Checked="@question.Value"
                                              CheckedChanged="(v)=> VM.TogglePlannerAsync(question, v)"
                                              OnLabel="Yes"
                                              OffLabel="No"
                                              CssClass="ans-switch-btn flex-shrink-0">
                                    </SfSwitch>

                                </div>
                            }
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4">
        <div class="ans-mini-card-container flex-fill h-100">
            <div class="ans-mini-card-header">
                <div class="ans-mini-card-header-title">Artwork & Regulatory Review</div>
                <div class="ans-mini-card-header-para">Confirm artwork and regulatory requirements.</div>
            </div>
            <div class="ans-mini-card-body">
                <div class="row mt-2 mb-2">
                    <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                        @if (VM.ArtWorkQuestion != null)
                        {
                            foreach (var question in VM.ArtWorkQuestion)
                            {
                                <div class="d-flex justify-content-between gap-3 mb-2">
                                    <div class="ans-mini-card-list-label">@question.QuestionText</div>
                                    <SfSwitch TChecked="bool?"
                                              Checked="@question.Value"
                                              CheckedChanged="(v)=> VM.TogglePlannerAsync(question, v)"
                                              OnLabel="Yes"
                                              OffLabel="No"
                                              CssClass="ans-switch-btn flex-shrink-0">
                                    </SfSwitch>

                                </div>
                            }
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Navigation -->
<div class="stepper-nav mb-3">
    <div class="nav-btns">
       @*  <button @onclick="LauchNPI" class="ans-secondary-button">
            Launch Product
        </button> *@

        <button class="ans-primary-button" @onclick="LauchNPI">
            Launch & Next
        </button>
    </div>
</div>

@if (VM.IsLaunching)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="text-center">
                        <video autoplay muted loop playsinline class="w-50">
                            <source src="assets/img/loading.mp4" type="video/mp4" />
                        </video>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isChecked = true;
    [Parameter]
    public NpiRecordDto NpiRecord { get; set; } = new NpiRecordDto();
    [Parameter]
    public NpiDetailViewModel VM { get; set; }
    [Parameter]
    public EventCallback<int> TabNavigation { get; set; }

    public async Task LauchNPI()
    {
        await VM.SaveRecordAsync();
        await TabNavigation.InvokeAsync(1);
    }
}
